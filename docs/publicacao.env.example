# Copie para .env.publish na raiz e preencha localmente. Não cole o token no chat.
# Conta pessoal GitHub que será proprietária do repositório (sem @).
GITHUB_USER=SEU_USUARIO

# Vazio = SEU_USUARIO.github.io. Outro nome publica em /nome-do-repositorio/.
GITHUB_REPO=

# Personal access token com as permissões descritas em PUBLICAR-COM-AGENTE.md.
GH_TOKEN=PREENCHA_SEU_TOKEN

# Identidade pública dos commits. Pode usar o e-mail noreply fornecido pelo GitHub.
GIT_AUTHOR_NAME="Gabriel Sousa"
GIT_AUTHOR_EMAIL=PREENCHA_EMAIL_DE_COMMIT
