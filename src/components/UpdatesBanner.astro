---
import { longDate } from '../lib/dates';
import { href } from '../lib/paths';
import type { Update } from '../lib/updates';
import { collectUpdates } from '../lib/updates';
import { getPosts } from '../lib/posts';
import { certifications } from '../data/cv';
import { news } from '../data/news';
import { projects } from '../data/projects';

interface Props { items?: Update[]; compact?: boolean }
const { items = collectUpdates(await getPosts(), news, projects, certifications), compact = false } = Astro.props;
---

<div class:list={['updates', { compact }]}>
<div class="updates-banner" data-updates-banner>
	{items.map((item, index) => (
		<details class:list={['update-card', { 'has-image': item.image }]} name={compact ? 'floating-updates' : 'home-updates'} open={index === 0}>
			<summary class="update-selector" aria-label={`Preview: ${item.title}`}>
				{item.image && <img class="update-image" src={href(item.image)} alt={item.imageAlt ?? ''} loading="lazy" decoding="async" />}
				<span class="update-category">{item.category}</span>
				<span class="update-short">{item.shortTitle ?? item.title}</span>
			</summary>
			<div class="update-details">
				{item.date && <p class="update-date">{item.dateLabel && `${item.dateLabel} `}<time datetime={item.date}>{longDate(new Date(`${item.date}T00:00:00Z`))}</time></p>}
				<h3>{compact ? item.shortTitle ?? item.title : item.title}</h3>
				<p class="update-summary">{item.summary}</p>
				<a class="update-link" href={href(item.url)} target="_blank" rel="noopener" aria-label={`${item.cta}: ${item.title}`}>{item.cta}</a>
			</div>
		</details>
	))}
</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-updates-banner]').forEach((banner) => {
		const cards = [...banner.querySelectorAll<HTMLDetailsElement>('details')];
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let hovered = false;
		let timer: number | undefined;
		const schedule = () => {
			window.clearTimeout(timer);
			if (cards.length < 2 || hovered || banner.matches(':focus-within') || document.hidden || reducedMotion.matches || !banner.getClientRects().length) return;
			timer = window.setTimeout(() => {
				const current = cards.findIndex((card) => card.open);
				cards[(current + 1) % cards.length].open = true;
				schedule();
			}, 3000);
		};
		banner.addEventListener('pointerenter', (event) => {
			if (event.pointerType === 'mouse') { hovered = true; schedule(); }
		});
		banner.addEventListener('pointerleave', () => { hovered = false; schedule(); });
		banner.addEventListener('focusin', schedule);
		banner.addEventListener('focusout', () => queueMicrotask(schedule));
		document.addEventListener('visibilitychange', schedule);
		reducedMotion.addEventListener('change', schedule);
		new IntersectionObserver(schedule).observe(banner);
		cards.forEach((card, index) => {
			const selector = card.querySelector('summary')!;
			card.addEventListener('pointerenter', (event) => {
				if (event.pointerType === 'mouse') card.open = true;
			});
			card.addEventListener('focusin', () => { card.open = true; });
			selector.addEventListener('click', (event) => {
				if (card.open) event.preventDefault();
			});
			selector.addEventListener('keydown', (event) => {
				let next = index;
				if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % cards.length;
				else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + cards.length) % cards.length;
				else if (event.key === 'Home') next = 0;
				else if (event.key === 'End') next = cards.length - 1;
				else return;
				event.preventDefault();
				cards[next].querySelector('summary')!.focus();
			});
		});
		schedule();
	});
</script>

<style>
	.updates { container-type: inline-size; }
	.updates-banner {
		display: flex;
		gap: 0.625rem;
	}
	.update-card {
		position: relative;
		flex: 1 1 0;
		min-width: 0;
		height: 7.5rem;
		overflow: hidden;
		border: 1px solid var(--line-strong);
		border-radius: 1rem;
		color: var(--text);
		background: var(--raised);
		transition: flex-grow 0.6s ease-in-out, border-color 0.3s ease;
	}
	.update-card[open] {
		flex-grow: 3.5;
		border-color: var(--accent);
	}
	.update-selector {
		position: absolute;
		inset: 0;
		list-style: none;
		cursor: pointer;
		background: radial-gradient(ellipse at top right, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
	}
	.update-selector::-webkit-details-marker { display: none; }
	.update-selector:focus-visible { outline-offset: -5px; border-radius: 1rem; }
	.update-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 35%;
	}
	.has-image { color: #fff; background: #0b1118; }
	.has-image .update-selector::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(5 12 20 / 65%), rgb(5 12 20 / 72%) 35%, rgb(5 12 20 / 96%));
	}
	.update-category,
	.update-short {
		position: absolute;
		z-index: 1;
		left: 0.875rem;
		right: 0.875rem;
	}
	.update-category {
		top: 0.5rem;
		font-size: 0.625rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.update-short {
		bottom: 0.625rem;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.35;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		transition: opacity 0.3s ease;
	}
	.update-card[open] .update-short { opacity: 0; }
	.update-card:not([open]) .update-category { display: none; }
	.update-card[open] .update-category { right: auto; }
	.update-details {
		position: absolute;
		inset: 1.75rem 0.875rem 0.625rem;
		display: flex;
		flex-direction: column;
		pointer-events: none;
	}
	.update-card[open] .update-details { animation: preview-in 0.6s ease both; }
	@keyframes preview-in { from { opacity: 0; } to { opacity: 1; } }
	.update-date {
		position: absolute;
		top: -1.25rem;
		right: 0;
		font-size: 0.625rem;
		opacity: 0.8;
	}
	.update-details h3 {
		font-family: var(--serif);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.015em;
		text-wrap: balance;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.update-summary {
		margin-top: 0.25rem;
		font-size: 0.75rem;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
		overflow: hidden;
	}
	.update-link {
		display: inline-block;
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.3em;
		pointer-events: auto;
	}
	/* Stretch the real link over the expanded image, including its edges. */
	.update-link::after {
		content: '';
		position: absolute;
		inset: -1.75rem -0.875rem -0.625rem;
	}
	.update-link:focus-visible::after {
		outline: 2px solid var(--focus);
		outline-offset: -4px;
		border-radius: 1rem;
	}
	@container (max-width: 46rem) {
		.updates-banner { flex-direction: column; }
		.update-card { flex: none; height: 1.35rem; transition: height 0.6s ease-in-out; }
		.update-card[open] { flex: none; height: 7.2rem; }
		.update-short { bottom: auto; top: 50%; transform: translateY(-50%); -webkit-line-clamp: 1; }
	}
	.compact .updates-banner { flex-direction: row; gap: 0.25rem; }
	.compact .update-card { flex: 1 1 0; height: 5rem; border-radius: 0.5rem; transition: flex-grow 0.6s ease-in-out; }
	.compact .update-card[open] { flex-grow: 8; }
	.compact .update-category,
	.compact .update-short,
	.compact .update-date,
	.compact .update-summary { display: none; }
	.compact .update-details { inset: 0.5rem; }
	.compact .update-details h3 { font-family: var(--sans); font-size: 0.75rem; line-height: 1.3; -webkit-line-clamp: 3; }
	.compact .update-link { font-size: 0.625rem; }
	.compact .update-link::after { inset: -0.5rem; }
	@media (prefers-reduced-motion: reduce) {
		.update-card, .update-short { transition: none; }
		.update-card[open] .update-details { animation: none; }
	}
	@media print {
		.updates-banner { display: block; }
		.update-card { height: auto; margin-bottom: 1rem; }
		.update-selector { position: static; padding: 1rem; }
		.update-short { position: static; transform: none; }
		.update-details, .update-image, .update-category { display: none; }
		.update-card[open] .update-short { opacity: 1; }
	}
</style>
