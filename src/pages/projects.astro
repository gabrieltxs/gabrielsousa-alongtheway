---
import Row from '../components/Row.astro';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';

const description = 'Applied work on language models: domain-adaptive pre-training, post-training, alignment tooling and agentic RAG systems.';
---

<Base title="Projects" description={description} noindex={projects.length === 0}>
	<div class="row page-head">
		<div></div>
		<div>
			<h1 class="page-title">Projects</h1>
			<p class="page-intro">Applied work on language models, from data curation to alignment.</p>
		</div>
	</div>

	{
		projects.length === 0 && (
			<Row label="Projects">
				<p>No projects are listed yet.</p>
			</Row>
		)
	}

	{
		projects.map((project, index) => (
			<Row label={project.period} id={`project-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
				<article class="project-card glow" style={`--hue: ${[212, 38, 160, 268][index % 4]}`}>
					{project.tags && project.tags.length > 0 && <p class="work-kind">{project.tags[0]}</p>}
					<h3 class="project-title">{project.name}</h3>
					<p class="project-tagline">{project.tagline}</p>
					<p class="project-summary">{project.summary}</p>
					{project.role && <p class="meta">My part: {project.role}</p>}
					{project.tags && project.tags.length > 1 && (
						<ul class="tags">
							{project.tags.slice(1).map((tag) => (
								<li><span class="tag">{tag}</span></li>
							))}
						</ul>
					)}
					{project.links && project.links.length > 0 && (
						<ul class="project-links">
							{project.links.map((link) => (
								<li><a class="button" href={href(link.url)} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span></a></li>
							))}
						</ul>
					)}
				</article>
			</Row>
		))
	}
</Base>
