---
import Row from '../components/Row.astro';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';

const chronologicalProjects = [...projects].sort((a, b) => b.period.localeCompare(a.period, 'en', { numeric: true }));

const description = 'Applied work on language models: domain-adaptive pre-training, post-training, alignment tooling and agentic RAG systems.';
---

<Base title="Projects" description={description} noindex={projects.length === 0}>
	<div class="row page-head">
		<div></div>
		<div>
			<h1 class="page-title">Projects</h1>
			<p class="page-intro">Applied work on language models, from data curation to alignment.</p>
		</div>
	</div>

	{
		projects.length === 0 && (
			<Row label="Projects">
				<p>No projects are listed yet.</p>
			</Row>
		)
	}

	{projects.length > 0 && (
		<Row label="Projects">
			<ul class="entries timeline">
				{chronologicalProjects.map((project) => (
					<li class="entry" id={`project-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
						<h3 class="entry-title">{project.name}</h3>
						<span class="entry-when">{project.period}</span>
						<p class="entry-desc">{project.tagline}</p>
						<p class="entry-desc">{project.summary}</p>
						{project.role && <p class="entry-desc">My part: {project.role}</p>}
						{project.tags && project.tags.length > 0 && (
							<ul class="tags entry-extra">
								{project.tags.map((tag) => <li><span class="tag">{tag}</span></li>)}
							</ul>
						)}
						{project.links && project.links.length > 0 && (
							<ul class="entry-extra inline-links">
								{project.links.map((link) => <li><a class="link" href={href(link.url)} target="_blank" rel="noopener">{link.label}</a></li>)}
							</ul>
						)}
					</li>
				))}
			</ul>
		</Row>
	)}
</Base>
