---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, index) => ({
		params: { slug: post.id },
		// The list is newest first, so the newer post is the one before this one.
		props: { post, newer: posts[index - 1], older: posts[index + 1] },
	}));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} headings={headings} newer={newer} older={older}>
	<Content />
</Post>
