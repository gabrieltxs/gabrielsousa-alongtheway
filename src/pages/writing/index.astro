---
import Base from '../../layouts/Base.astro';
import { writingCategories, categoryPath } from '../../data/writing';
import { href } from '../../lib/paths';
import { getPosts, postPath } from '../../lib/posts';

const posts = await getPosts();
const description = 'Research, experiments, builds and the work behind them. Choose a path to explore.';
---

<Base title="Writing" description={description}>
	<section class="writing-gateway" aria-labelledby="writing-title">
		<header class="gateway-heading">
			<h1 id="writing-title" class="page-title">Writing</h1>
			<p>{description}</p>
		</header>
		<nav class="category-banners" aria-label="Writing categories">
			{writingCategories.map((category, index) => {
				const entries = posts.filter(post => post.data.category === category.id);
				const cover = entries.find(post => post.data.image)?.data.image;
				return (
					<a class:list={['category-banner', { 'is-active': index === 0 }]} href={href(categoryPath(category.id))} style={`--category-hue: ${category.hue}`} aria-labelledby={`category-${category.id}`} aria-describedby={`count-${category.id}`}>
						{cover && <img class="category-image" src={href(cover)} alt="" decoding="async" />}
						<span class="category-number" aria-hidden="true">0{index + 1}</span>
						<svg class="category-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=".8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={category.icon} /></svg>
						<div class="category-caption">
							<h2 id={`category-${category.id}`}>{category.title}</h2>
							<p class="category-description">{category.description}</p>
							<p class="category-count" id={`count-${category.id}`}>{entries.length ? `${entries.length} ${entries.length === 1 ? 'post' : 'posts'}` : 'No posts yet'} <span aria-hidden="true">↗</span></p>
						</div>
					</a>
				);
			})}
		</nav>
		<div class="gateway-controls">
			<span>Choose a category to read its timeline.</span>
			<button class="text-button" type="button" data-category-pause aria-pressed="false" hidden>Pause rotation</button>
		</div>
		<section class="latest-writings" aria-labelledby="latest-writings-title">
			<h2 id="latest-writings-title">Latest writings</h2>
			<ol>
				{posts.slice(0, 3).map(post => (
					<li>
						<a href={href(postPath(post))} title={post.data.title}>
							<span class="latest-category">{writingCategories.find(category => category.id === post.data.category)!.title}</span>
							<h3>{post.data.shortTitle ?? post.data.title}</h3>
							<p class="latest-description">{post.data.plain ?? post.data.description}</p>
							<span class="latest-arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ol>
		</section>
	</section>
</Base>

<style>
	:global(.writing-landing-page) { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: clip; }
	:global(.writing-landing-page > header) { flex: none; }
	:global(.writing-landing-page > main) { flex: 1; min-height: 0; max-width: 90rem; display: flex; padding-block: clamp(.5rem, 3vh, 2rem); }
	.writing-gateway { flex: 1; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: clamp(.75rem, 2vh, 1.5rem); max-height: 58rem; margin-block: auto; height: 100%; }
	.gateway-heading { text-align: center; flex: none; }
	.gateway-heading p { color: var(--muted); margin-top: .6rem; font-size: clamp(.875rem, 1.2vw, 1.0625rem); }
	.category-banners { display: flex; flex: 1; min-height: 0; gap: clamp(.4rem, 1vw, 1rem); }
	.category-banner {
		position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end;
		flex: 1; min-width: 0; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 1rem;
		padding: clamp(.75rem, 1.6vw, 1.6rem); text-decoration: none; color: var(--text);
		background: linear-gradient(160deg, hsl(var(--category-hue) 50% 50% / .22), transparent 80%), var(--raised);
		transition: flex-grow .6s ease, border-color .3s ease;
	}
	.category-banner.is-active { flex-grow: 1.8; border-color: var(--accent); }
	.category-banner:focus-visible { outline-offset: -5px; }
	.category-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .16; z-index: -2; filter: saturate(.5); }
	.category-banner::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(transparent, var(--raised) 95%); }
	.category-number { position: absolute; top: 1rem; left: 1rem; font-size: .75rem; color: var(--muted); letter-spacing: .1em; }
	.category-symbol { position: absolute; width: clamp(3rem, 5vw, 4rem); top: 15%; left: 50%; transform: translateX(-50%); color: var(--text-2); opacity: .7; }
	.category-caption h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(1.25rem, 2.2vw, 2.2rem); line-height: 1.15; }
	.category-description { display: none; margin-top: 1rem; font-size: .875rem; line-height: 1.5; color: var(--text-2); }
	.is-active .category-description { display: block; }
	.category-count { display: flex; justify-content: space-between; gap: .5rem; margin-top: 1rem; font-size: .75rem; color: var(--muted); }
	.category-count span { color: var(--accent); font-size: 1.1rem; line-height: 1; }
	.gateway-controls { display: flex; justify-content: space-between; gap: .75rem; flex: none; font-size: .75rem; color: var(--muted); }
	.latest-writings { flex: none; border-top: 1px solid var(--line); padding-top: .75rem; }
	.latest-writings h2 { font-size: .875rem; font-weight: 500; margin-bottom: .5rem; }
	.latest-writings ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .65rem; padding: 0; list-style: none; }
	.latest-writings a { position: relative; display: flex; flex-direction: column; justify-content: center; height: 100%; min-height: 7.5rem; padding: .65rem 2rem .65rem .8rem; border: 1px solid var(--line-strong); border-radius: .65rem; background: var(--raised); text-decoration: none; }
	.latest-writings a:hover { border-color: var(--accent); }
	.latest-category { color: var(--muted); font-size: .6875rem; line-height: 1.3; }
	.latest-writings h3 { font-size: .9375rem; font-weight: 500; margin-top: .2rem; }
	.latest-description { margin-top: .45rem; font-size: .8125rem; line-height: 1.4; color: var(--text-2); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
	.latest-arrow { position: absolute; right: .65rem; top: 50%; transform: translateY(-50%); color: var(--accent); }
	@media (max-width: 44rem) {
		:global(.writing-landing-page > main) { padding-inline: 1rem; padding-block: .5rem 1rem; }
		.writing-gateway { gap: .65rem; }
		.gateway-heading .page-title { font-size: 2rem; }
		.gateway-heading p { max-width: 32rem; margin-inline: auto; line-height: 1.4; }
		.category-banners { flex-direction: column; gap: .45rem; }
		.category-banner { flex: 1; min-height: 0; padding: .5rem 1rem .5rem 3.5rem; justify-content: center; border-radius: .65rem; transition: flex-grow .6s ease; }
		.category-banner.is-active { flex-grow: 1.8; }
		.category-number { top: .4rem; left: .6rem; font-size: .6rem; }
		.category-symbol { width: 1.75rem; top: 50%; left: 1.6rem; transform: translate(-50%, -50%); }
		.category-caption h2 { font-size: 1.25rem; }
		.category-description { margin-top: .3rem; font-size: .75rem; line-height: 1.3; }
		.category-count { margin-top: .2rem; font-size: .65rem; }
		.category-image { object-position: center 40%; }
		.gateway-controls { font-size: .65rem; align-items: center; }
		.latest-writings ol { grid-template-columns: 1fr; gap: .3rem; }
		.latest-writings a { min-height: 88px; padding: .3rem 1.75rem .3rem .6rem; }
		.latest-writings h3 { font-size: .8125rem; margin-top: .1rem; }
		.latest-description { font-size: .75rem; margin-top: .3rem; -webkit-line-clamp: 2; }
	}
	@media (max-height: 700px) {
		.category-description { display: none !important; }
		.gateway-heading p { display: none; }
	}
	@media (max-width: 44rem) and (max-height: 700px) {
		.category-banner, .category-banner.is-active { flex-grow: 1; padding-block: .25rem; }
		.category-caption h2 { font-size: 1.125rem; }
		.category-count { line-height: 1.1; }
	}
	@media (max-height: 500px) {
		:global(.writing-landing-page .site-header) { padding-block: .5rem; row-gap: .35rem; }
		:global(.writing-landing-page > main) { padding-block: .35rem; }
		.gateway-heading .page-title { font-size: 1.5rem; }
		.writing-gateway { gap: .4rem; }
		.category-symbol { display: none; }
		.category-number { display: none; }
		.category-count { margin-top: .2rem; }
		.category-caption h2 { font-size: 1.125rem; }
		.gateway-controls > span { display: none; }
		.gateway-controls { justify-content: flex-end; }
	}
	@media (prefers-reduced-motion: reduce) { .category-banner { transition: none; } }
	@media (orientation: landscape) and (max-height: 500px) {
		.category-banners { flex-direction: row; }
		.category-banner { padding: .6rem; justify-content: flex-end; }
		.latest-writings ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.latest-writings { padding-top: .35rem; }
		.latest-writings h2 { margin-bottom: .3rem; font-size: .75rem; }
	}
	@media (orientation: landscape) and (max-height: 400px) {
		.gateway-heading { display: none; }
		:global(.writing-landing-page .site-header) { padding-block: .15rem; row-gap: 0; }
		.category-banner { padding: .25rem .5rem; justify-content: center; }
		.category-caption h2 { font-size: 1rem; }
		.category-count { display: none; }
		.latest-writings a { min-height: 104px; padding-block: .25rem; }
		.latest-writings h3 { font-size: .75rem; line-height: 1.2; }
		.latest-category { font-size: .625rem; line-height: 1.2; }
	}
	@media (max-width: 44rem) and (max-height: 900px) and (orientation: portrait) {
		.writing-gateway { gap: .4rem; }
		.gateway-heading .page-title { font-size: 1.5rem; }
		.gateway-heading p { display: none; }
		.category-banners { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(44px, 1fr)); }
		.category-banner { padding: .3rem .5rem; }
		.category-banner:last-child { grid-column: 1 / -1; }
		.category-caption h2 { font-size: 1rem; }
		.category-number, .category-symbol, .category-description, .category-count { display: none !important; }
		.latest-writings { padding-top: .4rem; }
	}
	@media (max-width: 44rem) and (max-height: 740px) and (orientation: portrait) {
		:global(.writing-landing-page .site-header) { padding-block: .5rem; row-gap: .35rem; }
		.latest-writings ol { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.latest-writings a { min-height: 120px; padding: .4rem; justify-content: flex-start; }
		.latest-writings h3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
		.latest-description { -webkit-line-clamp: 3; }
		.latest-arrow { display: none; }
	}
</style>

<script>
	const banners = document.querySelector<HTMLElement>('.category-banners')!;
	const cards = [...banners.querySelectorAll<HTMLAnchorElement>('.category-banner')];
	const pause = document.querySelector<HTMLButtonElement>('[data-category-pause]')!;
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
	let current = 0;
	let paused = reducedMotion.matches;
	let hovered = false;
	let timer: number | undefined;
	const activate = (index: number) => {
		current = index;
		cards.forEach((card, i) => card.classList.toggle('is-active', i === index));
	};
	const schedule = () => {
		clearTimeout(timer);
		pause.setAttribute('aria-pressed', String(paused));
		pause.textContent = paused ? 'Resume rotation' : 'Pause rotation';
		if (paused || hovered || banners.matches(':focus-within') || document.hidden) return;
		timer = window.setTimeout(() => { activate((current + 1) % cards.length); schedule(); }, 5000);
	};
	pause.hidden = false;
	pause.addEventListener('click', () => { paused = !paused; schedule(); });
	banners.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovered = true; schedule(); } });
	banners.addEventListener('pointerleave', () => { hovered = false; schedule(); });
	banners.addEventListener('focusout', () => queueMicrotask(schedule));
	cards.forEach((card, index) => {
		card.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') activate(index); });
		card.addEventListener('focus', () => { activate(index); schedule(); });
	});
	document.addEventListener('visibilitychange', schedule);
	reducedMotion.addEventListener('change', () => { paused = reducedMotion.matches; schedule(); });
	schedule();
</script>
