---
// LinkedIn and GitHub use the official marks from Font Awesome Free (icons CC BY 4.0).
import { faGithub, faLinkedinIn } from '@fortawesome/free-brands-svg-icons';
import UpdatesBanner from '../components/UpdatesBanner.astro';
import { certifications } from '../data/cv';
import { news } from '../data/news';
import { education } from '../data/cv';
import { activeLinks, profile } from '../data/profile';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';
import { href } from '../lib/paths';
import { getPosts } from '../lib/posts';
import { collectUpdates } from '../lib/updates';

const allPosts = await getPosts();
const updates = collectUpdates(allPosts, news, projects, certifications);
const links = activeLinks();

// The profile links under the name, as icons. Generic line icons, one per link.
const icons: Record<string, string> = {
	cv: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9 12h6M9 16h6"/>',
	lattes: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2.5 9 2.5 12 0v-5M22 9v6"/>',
};
// Official brand marks, drawn as a single flat fill in the text colour.
const brands: Record<string, { width: number; height: number; path: string }> = {
	linkedin: { width: faLinkedinIn.icon[0], height: faLinkedinIn.icon[1], path: String(faLinkedinIn.icon[4]) },
	github: { width: faGithub.icon[0], height: faGithub.icon[1], path: String(faGithub.icon[4]) },
};
const iconLinks = [
	{ key: 'cv', label: 'CV', url: href('/cv/'), external: false },
	...['linkedin', 'lattes', 'github']
		.map((key) => links.find((link) => link.key === key))
		.filter((link) => link !== undefined)
		.map((link) => ({ key: link.key, label: link.label, url: link.url, external: true })),
];

// Tells search engines who this site is about and which profiles are yours.
const siteUrl = new URL(href('/'), Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: profile.name,
	honorificSuffix: 'M.Sc.',
	url: siteUrl,
	description: profile.description,
	jobTitle: profile.role,
	...(profile.employer && { worksFor: { '@type': 'Organization', name: profile.employer } }),
	alumniOf: [...new Set(education.map((item) => item.institution))].map((name) => ({
		'@type': 'CollegeOrUniversity',
		name,
	})),
	knowsAbout: profile.interests,
	sameAs: links.map((link) => link.url),
};
---

<Base jsonLd={jsonLd}>
	<div class="card-home">
		<header class="card-id">
			<img class="card-photo" src={href('/1649783605466.jpg')} alt={`Portrait of ${profile.name}`} width="400" height="400" fetchpriority="high" decoding="async" />
			<h1 class="card-name">{profile.displayName}</h1>
			<p class="card-role">
				{profile.role} at {profile.employer}<br />
				LLM Researcher at CEIA-UFG<br />
				{profile.location}
			</p>
			<ul class="icon-links">
				{iconLinks.map((link) => (
					<li>
						<a class="icon-link glow" style="--hue: 212" href={link.url} {...(link.external ? { target: '_blank', rel: 'me noopener' } : {})}>
							{brands[link.key] ? (
								<svg class="brand-mark" viewBox={`0 0 ${brands[link.key].width} ${brands[link.key].height}`} aria-hidden="true" fill="currentColor"><path d={brands[link.key].path} /></svg>
							) : (
								<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[link.key]} />
							)}
							<span>{link.label}</span>
						</a>
					</li>
				))}
			</ul>
		</header>

		<div class="card-content">
			<div class="card-reading">
				<p class="card-statement">{profile.statement}</p>
				<p class="card-subtitle">Then I build the experiments to test them, across <span>pre-training</span>, <span>post-training</span>, and <span>serving</span>.</p>
				<p class="card-author">Sousa, G.T.A.</p>
				<div class="card-about">
					{profile.about.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<p class="card-statement card-statement-2">
					<a href={href('/writing/')}>Here I write about what I’ve learned along the way.</a>
				</p>
				{updates.length > 0 && (
					<section class="card-updates" aria-label="Latest updates">
						<UpdatesBanner items={updates} />
					</section>
				)}
			</div>
		</div>
	</div>
</Base>
