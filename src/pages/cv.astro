---
import PublicationList from '../components/PublicationList.astro';
import Row from '../components/Row.astro';
import { awards, certifications, contactEmailEncoded, education, experience, languages, researchExperience, skills, summary } from '../data/cv';
import { profile } from '../data/profile';
import { publications } from '../data/publications';
import Base from '../layouts/Base.astro';
import { monthYear, period } from '../lib/dates';
import { href } from '../lib/paths';

const description = `Curriculum vitae of ${profile.displayName}, ${profile.headline}: experience, research, education and certifications.`;
---

<Base title="CV" description={description}>
	<div class="row page-head">
		<div></div>
		<div>
			<h1 class="page-title">Curriculum vitae</h1>
			<p class="page-intro">
				{profile.headline}. M.Sc. in Computer Science. {profile.role} at {profile.employer}, {profile.location}.
			</p>
			<ul class="inline-links no-print" style="margin-top: 1.5rem; font-size: 0.875rem">
				{contactEmailEncoded && (
					<li data-nosnippet>
						<button class="text-button" type="button" data-contact-email={contactEmailEncoded}>Show contact email</button>
					</li>
				)}
				{profile.cvPdfs.map((document) => (
					<li>
						<a class="link" href={href(document.url)} hreflang={document.language} type="application/pdf" download target="_blank" rel="noopener">
							{document.label}
						</a>
					</li>
				))}
				<li>
					<button class="text-button" type="button" data-print>Print or save as PDF</button>
				</li>
				{
					profile.links.lattes && (
						<li>
							<a class="link" href={profile.links.lattes}>
								Lattes CV
							</a>
						</li>
					)
				}
				{
					profile.links.linkedin && (
						<li>
							<a class="link" href={profile.links.linkedin}>
								LinkedIn
							</a>
						</li>
					)
				}
				{profile.links.github && (
					<li><a class="link" href={profile.links.github}>GitHub</a></li>
				)}
			</ul>
		</div>
	</div>

	<Row label="Summary">
		{summary.map((paragraph) => <p>{paragraph}</p>)}
	</Row>

	{
		experience.length > 0 && (
			<Row label="Experience">
				<ul class="entries timeline">
					{experience.map((job) => (
						<li class="entry">
							<h3 class="entry-title">{job.title}</h3>
							<span class="entry-when">{period(job.start, job.end)}</span>
							<p class="entry-desc">
								{job.organisation}
								{job.location && `, ${job.location}`}
							</p>
							{job.highlights && job.highlights.length > 0 && (
								<ul class="points">
									{job.highlights.map((point) => (
										<li>{point}</li>
									))}
								</ul>
							)}
							{job.links && job.links.length > 0 && (
								<ul class="entry-extra inline-links">
									{job.links.map((link) => (
										<li>
											<a class="link" href={href(link.url)}>
												{link.label}
											</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
			</Row>
		)
	}

	{
		researchExperience.length > 0 && (
			<Row label="Research">
				<ul class="entries">
					{researchExperience.map((project) => (
						<li class="entry">
							<h3 class="entry-title">{project.title}</h3>
							<span class="entry-when">{period(project.start, project.end)}</span>
							<p class="entry-desc">
								{project.organisation}
							</p>
							<ul class="points">
								{project.highlights?.map((point) => (
									<li>{point}</li>
								))}
							</ul>
							{project.links && (
								<ul class="entry-extra inline-links">
									{project.links.map((link) => (
										<li><a class="link" href={href(link.url)}>{link.label}</a></li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
			</Row>
		)
	}

	{
		education.length > 0 && (
			<Row label="Education">
				<ul class="entries">
					{education.map((item) => (
						<li class="entry">
							<h3 class="entry-title">{item.degree}</h3>
							<span class="entry-when">{period(item.start, item.end)}</span>
							<p class="entry-desc">{item.institution}</p>
							{item.notes?.map((note) => (
								<p class="entry-desc">{note}</p>
							))}
						</li>
					))}
				</ul>
			</Row>
		)
	}

	{
		publications.length > 0 && (
			<Row label="Publications">
				<PublicationList items={publications} compact />
			</Row>
		)
	}

	{
		skills.length > 0 && (
			<Row label="Expertise">
				<dl class="skills">
					{skills.map((group) => (
						<div>
							<dt>{group.area}</dt>
							<dd>{group.items}</dd>
						</div>
					))}
				</dl>
			</Row>
		)
	}

	{
		certifications.length > 0 && (
			<Row label="Certifications">
				<ul class="plain-list">
					{certifications.map((item) => (
						<li class="certification-row">
							<span>
							{item.url ? (
								<a class="link" href={item.url} target="_blank" rel="noopener">
									{item.name}
								</a>
							) : (
								item.name
							)}
							</span>
							{item.image && (
								<img class="certification-badge" src={href(item.image)} alt={item.imageAlt ?? `${item.name} badge`} width="48" height="48" loading="lazy" decoding="async" />
							)}
						</li>
					))}
				</ul>
			</Row>
		)
	}

	{
		awards.length > 0 && (
			<Row label="Recognition">
				<ul class="entries">
					{awards.map((award) => (
						<li class="entry">
							<p class="entry-title">{award.title}</p>
							<span class="entry-when">{monthYear(award.date)}</span>
							<p class="entry-desc">{award.issuer}</p>
							{award.links && (
								<ul class="entry-extra inline-links">
									{award.links.map((link) => (
										<li><a class="link" href={href(link.url)}>{link.label}</a></li>
									))}
								</ul>
							)}
						</li>
					))}
				</ul>
			</Row>
		)
	}

	{
		languages.length > 0 && (
			<Row label="Languages">
				<ul class="plain-list">
					{languages.map((language) => (
						<li class:list={{ 'certification-row': language.image }}>
							<div>
							{language.name}
							<span class="meta">
								{language.url ? (
									<a class="link" href={language.url} target="_blank" rel="noopener">
										{language.level}
									</a>
								) : (
									language.level
								)}
							</span>
							</div>
							{language.image && (
								<img class="certification-badge" src={href(language.image)} alt={language.imageAlt ?? `${language.name} certificate icon`} width="48" height="48" loading="lazy" decoding="async" />
							)}
						</li>
					))}
				</ul>
			</Row>
		)
	}
</Base>

<style>
	.certification-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 3rem;
		align-items: center;
		gap: 1rem;
		min-height: 3.5rem;
	}
	.certification-badge {
		width: 3rem;
		height: 3rem;
		object-fit: contain;
	}
	.certification-badge[src$='/fiap.svg'] {
		padding: 0.25rem;
		border-radius: 0.375rem;
		background: #0b1118;
	}
	.skills > div + div {
		margin-top: 1.1rem;
	}
	.skills dt {
		font-weight: 500;
	}
	.skills dd {
		margin-top: 0.2rem;
		color: var(--muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}
</style>

<script>
	document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
	const contactButton = document.querySelector<HTMLButtonElement>('[data-contact-email]');
	contactButton?.addEventListener('click', () => {
		const address = atob(contactButton.dataset.contactEmail!);
		const link = document.createElement('a');
		link.className = 'link';
		link.href = `mailto:${address}`;
		link.textContent = address;
		contactButton.replaceWith(link);
		link.focus();
	});
</script>
